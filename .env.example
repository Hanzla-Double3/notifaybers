# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Username of the account seeded on first startup. There is no password: sign-in is
# Google only (see below); ADMIN_EMAIL links this account to your Google login.
ADMIN_USERNAME=admin

# IANA timezone, e.g. Europe/London. Used as the default for new users.
DEFAULT_TIMEZONE=UTC

DATABASE_URL=sqlite:////app/data/notifaybers.db

# Generate with: python scripts/gen_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PATH=/app/data/vapid_private.pem
VAPID_SUBJECT=mailto:you@example.com

SESSION_MAX_AGE_DAYS=30
SESSION_SECURE_COOKIE=true

WEBHOOK_RATE_LIMIT_PER_MINUTE=30

# Public origin of this deployment (no trailing slash). Shown in the webhook
# cURL snippet and watchdog ping URLs. If empty, the request's own origin is used.
PUBLIC_BASE_URL=https://notify.example.com

# Admin-controlled floor for watchdog ping intervals, in seconds (minimum 60).
WATCHDOG_MIN_PING_SECONDS=60

# Sign in with Google (https://console.cloud.google.com/apis/credentials -> OAuth client ID,
# type "Web application"). Authorized redirect URI: <PUBLIC_BASE_URL>/auth/google/callback
# Required: there is no password login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your Google email: links the existing ADMIN_USERNAME account (and its data) on first sign-in.
ADMIN_EMAIL=
# Other Google emails allowed to sign in, comma-separated. ADMIN_EMAIL is always allowed.
ALLOWED_EMAILS=
# true = any verified Google account can sign up. Leave false for a private instance.
OPEN_SIGNUP=false
# LOCAL DEBUGGING ONLY. true = opening /login on localhost signs you in as ADMIN_USERNAME
# with no Google. Ignored for proxied requests; never set it on the server.
DEV_AUTO_LOGIN=false
